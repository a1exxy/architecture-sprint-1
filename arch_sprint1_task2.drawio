        <mxCell id="K4HZPsAFl-pIeoP7H-y3-25" value="&lt;font style=&quot;font-size: 23px;&quot;&gt;Система/Сервис&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;" vertex="1" parent="K4HZPsAFl-pIeoP7H-y3-23">
